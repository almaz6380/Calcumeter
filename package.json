{
  "name": "calcumeter",
  "version": "1.0.0",
  "description": "Calcumeter – Taschenrechner, Währungs- und Einheitenrechner (Web-App und Store-App mit Capacitor)",
  "private": true,
  "scripts": {
    "test": "node --test",
    "start": "python3 -m http.server 8080",
    "build:web": "python3 tools/build.py",
    "build": "python3 tools/build.py --app",
    "sync": "npm run build && npx cap sync",
    "assets": "npx capacitor-assets generate --assetPath resources --iconBackgroundColor '#0E0F11' --iconBackgroundColorDark '#0E0F11' --splashBackgroundColor '#0E0F11' --splashBackgroundColorDark '#0E0F11'",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
